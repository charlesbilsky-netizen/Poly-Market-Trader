# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# POLYMARKET CLOB API CREDENTIALS:
POLYMARKET_API_KEY=MY_POLYMARKET_API_KEY
POLYMARKET_API_SECRET=MY_POLYMARKET_API_SECRET
POLYMARKET_API_PASSPHRASE=MY_POLYMARKET_API_PASSPHRASE
POLYMARKET_ADDRESS=MY_POLYMARKET_ADDRESS

# XAI GROK API KEY:
XAI_API_KEY=MY_XAI_API_KEY

# OPENAI API KEY:
OPENAI_API_KEY=MY_OPENAI_API_KEY

