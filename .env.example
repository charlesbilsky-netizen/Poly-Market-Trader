# AI provider keys (all optional — the app works without them; AI research
# features unlock per provider). Users can also paste keys in-app (Settings),
# which override these build-time defaults.

# GEMINI_API_KEY: Google AI Studio key. Used for the research assistant and as
# the X-sentiment fallback via Google Search grounding.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# XAI_API_KEY: xAI Grok key. Preferred provider for X (Twitter) sentiment via
# Grok's native X live search.
XAI_API_KEY=MY_XAI_API_KEY

# OPENAI_API_KEY: OpenAI key. Research assistant fallback (no live data).
OPENAI_API_KEY=MY_OPENAI_API_KEY
